<?xml version="1.0" encoding="UTF-8" ?>
<schema name="opensolr-photos" version="1.6">

  <uniqueKey>id</uniqueKey>

  <field name="_version_" type="plong" indexed="false" stored="false" docValues="true"/>

  <field name="id" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="path" type="string" indexed="true" stored="true"/>
  <field name="folder" type="string" indexed="true" stored="true"/>
  <field name="file_name" type="string" indexed="true" stored="true"/>
  <field name="media_id" type="plong" indexed="true" stored="true"/>
  <field name="mime" type="string" indexed="true" stored="true"/>
  <field name="size_bytes" type="plong" indexed="true" stored="true"/>
  <field name="width" type="pint" indexed="true" stored="true"/>
  <field name="height" type="pint" indexed="true" stored="true"/>
  <field name="orientation" type="string" indexed="true" stored="true"/>

  <field name="taken_at" type="pdate" indexed="true" stored="true"/>
  <field name="year" type="pint" indexed="true" stored="true"/>
  <field name="month" type="pint" indexed="true" stored="true"/>
  <field name="modified_at" type="pdate" indexed="true" stored="true"/>

  <field name="camera_make" type="string" indexed="true" stored="true"/>
  <field name="camera_model" type="string" indexed="true" stored="true"/>
  <field name="lens" type="string" indexed="true" stored="true"/>
  <field name="iso" type="pint" indexed="true" stored="true"/>
  <field name="exposure" type="string" indexed="true" stored="true"/>
  <field name="f_number" type="pfloat" indexed="true" stored="true"/>
  <field name="focal_length" type="pfloat" indexed="true" stored="true"/>
  <field name="flash" type="boolean" indexed="true" stored="true"/>

  <!-- Where the photo was taken, in words (from the GPS position through Opensolr's
       nearby_places): the nearest named place and its administrative parents. -->
  <field name="city" type="string" indexed="true" stored="true"/>
  <field name="region" type="string" indexed="true" stored="true"/>
  <field name="province" type="string" indexed="true" stored="true"/>
  <field name="community" type="string" indexed="true" stored="true"/>
  <field name="country" type="string" indexed="true" stored="true"/>
  <field name="country_code" type="string" indexed="true" stored="true"/>
  <field name="place_text" type="text_photo" indexed="true" stored="false" multiValued="true"/>
  <field name="has_location" type="boolean" indexed="true" stored="true"/>
  <field name="location" type="location" indexed="true" stored="true"/>
  <field name="altitude" type="pfloat" indexed="true" stored="true"/>

  <field name="meaning" type="text_photo" indexed="true" stored="true"/>
  <field name="labels" type="string" indexed="true" stored="true" multiValued="true"/>
  <!-- Words the owner added to the photo by hand. They outrank the CLIP words in search. -->
  <field name="custom_tags" type="string" indexed="true" stored="true" multiValued="true"/>
  <!-- The tags as words, for search: "luminita" finds the tag "Luminița". -->
  <field name="custom_tags_text" type="text_photo" indexed="true" stored="false" multiValued="true"/>
  <field name="embeddings" type="knn_vector" indexed="true" stored="false"/>
  <field name="clip_model" type="string" indexed="true" stored="true"/>
  <field name="embed_model" type="string" indexed="true" stored="true"/>
  <field name="indexed_at" type="pdate" indexed="true" stored="true"/>

  <!-- Every word autocomplete offers: CLIP labels, camera make and model, place names. -->
  <field name="suggest" type="string" indexed="false" stored="true" multiValued="true"/>
  <field name="spell" type="text_spell" indexed="true" stored="false" multiValued="true"/>
  <field name="text" type="text_photo" indexed="true" stored="false" multiValued="true"/>
  <field name="file_name_text" type="text_photo" indexed="true" stored="false"/>
  <field name="folder_text" type="text_photo" indexed="true" stored="false"/>
  <field name="camera_text" type="text_photo" indexed="true" stored="false" multiValued="true"/>

  <copyField source="meaning" dest="text"/>
  <copyField source="file_name" dest="file_name_text"/>
  <copyField source="folder" dest="folder_text"/>
  <copyField source="camera_make" dest="camera_text"/>
  <copyField source="camera_model" dest="camera_text"/>
  <copyField source="file_name" dest="text"/>
  <copyField source="folder" dest="text"/>
  <copyField source="camera_make" dest="text"/>
  <copyField source="camera_model" dest="text"/>
  <copyField source="city" dest="place_text"/>
  <copyField source="region" dest="place_text"/>
  <copyField source="province" dest="place_text"/>
  <copyField source="community" dest="place_text"/>
  <copyField source="country" dest="place_text"/>
  <copyField source="city" dest="text"/>
  <copyField source="region" dest="text"/>
  <copyField source="country" dest="text"/>
  <copyField source="custom_tags" dest="custom_tags_text"/>
  <copyField source="custom_tags" dest="text"/>
  <copyField source="custom_tags" dest="spell"/>
  <copyField source="custom_tags" dest="suggest"/>
  <copyField source="labels" dest="spell"/>
  <copyField source="file_name" dest="spell"/>
  <copyField source="camera_make" dest="spell"/>
  <copyField source="camera_model" dest="spell"/>
  <copyField source="city" dest="spell"/>
  <copyField source="region" dest="spell"/>
  <copyField source="province" dest="spell"/>
  <copyField source="community" dest="spell"/>
  <copyField source="country" dest="spell"/>
  <copyField source="labels" dest="suggest"/>
  <copyField source="camera_make" dest="suggest"/>
  <copyField source="camera_model" dest="suggest"/>
  <copyField source="city" dest="suggest"/>
  <copyField source="region" dest="suggest"/>
  <copyField source="province" dest="suggest"/>
  <copyField source="country" dest="suggest"/>

  <dynamicField name="*_s" type="string" indexed="true" stored="true"/>
  <dynamicField name="*_ss" type="string" indexed="true" stored="true" multiValued="true"/>
  <dynamicField name="*_i" type="pint" indexed="true" stored="true"/>
  <dynamicField name="*_l" type="plong" indexed="true" stored="true"/>
  <dynamicField name="*_f" type="pfloat" indexed="true" stored="true"/>
  <dynamicField name="*_b" type="boolean" indexed="true" stored="true"/>
  <dynamicField name="*_dt" type="pdate" indexed="true" stored="true"/>
  <dynamicField name="*_t" type="text_photo" indexed="true" stored="true"/>

  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true"/>
  <fieldType name="boolean" class="solr.BoolField" sortMissingLast="true" docValues="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  <fieldType name="pfloat" class="solr.FloatPointField" docValues="true"/>
  <fieldType name="pdate" class="solr.DatePointField" docValues="true"/>
  <fieldType name="location" class="solr.LatLonPointSpatialField" docValues="true"/>
  <fieldType name="knn_vector" class="solr.DenseVectorField" vectorDimension="1024" similarityFunction="cosine"/>

  <!-- Words as typed, lower-cased and accent-folded, unstemmed: what the spellchecker
       compares against and what the suggester analyses the labels with. -->
  <fieldType name="text_spell" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.ASCIIFoldingFilterFactory"/>
    </analyzer>
  </fieldType>

  <fieldType name="text_photo" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.ASCIIFoldingFilterFactory"/>
      <filter class="solr.EnglishPossessiveFilterFactory"/>
      <filter class="solr.KeywordMarkerFilterFactory" protected="protwords.txt"/>
      <filter class="solr.KStemFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt"/>
      <filter class="solr.SynonymGraphFilterFactory" synonyms="synonyms.txt" ignoreCase="true" expand="true"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.ASCIIFoldingFilterFactory"/>
      <filter class="solr.EnglishPossessiveFilterFactory"/>
      <filter class="solr.KeywordMarkerFilterFactory" protected="protwords.txt"/>
      <filter class="solr.KStemFilterFactory"/>
    </analyzer>
  </fieldType>

</schema>
